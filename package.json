{
  "name": "exams-generator",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d postgres minio redis",
    "dev:down": "docker compose -f infra/docker-compose.yml stop postgres minio redis",
    "db:setup": "pnpm --filter @exams-generator/api db:migrate && pnpm --filter @exams-generator/api db:seed",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "smoke:domains": "node infra/smoke-test-domains.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/**/*.{ts,html,scss}\" \"packages/**/*.ts\" \"*.{json,md}\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,html,scss}\" \"packages/**/*.ts\" \"*.{json,md}\" \"docs/**/*.md\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
