---
import "@fontsource/caveat/700.css";
import "@fontsource/nunito/400.css";

interface Props {
	title: string;
	description: string;
	ogImage?: string;
	ogImageAlt?: string;
	/** Utility pages (login, 404) set this so they never reach search results. */
	noindex?: boolean;
}

const {
	title,
	description,
	ogImage = "/screens/bank.png",
	ogImageAlt = "Banco de preguntas de GeneraExamen: árbol de cursos y temas con el detalle de la pregunta seleccionada",
	noindex = false,
} = Astro.props;
const ogImageUrl = new URL(ogImage, Astro.url).toString();
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{
			/* noindex pages get no canonical either: a self-canonical on a page
			   asking to be de-indexed sends robots mixed signals. */
			noindex ? (
				<meta name="robots" content="noindex" />
			) : (
				<link rel="canonical" href={Astro.url.toString()} />
			)
		}
		<meta
			name="theme-color"
			media="(prefers-color-scheme: light)"
			content="#ecefe9"
		/>
		<meta
			name="theme-color"
			media="(prefers-color-scheme: dark)"
			content="#21362c"
		/>
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="GeneraExamen" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:url" content={Astro.url.toString()} />
		<meta property="og:locale" content="es_PE" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<script is:inline>
			// Set theme before paint so there's no flash: respects a stored
			// choice first, falls back to the OS preference otherwise.
			(function () {
				var stored = localStorage.getItem("examgen-theme");
				if (stored === "dark" || stored === "light") {
					document.documentElement.setAttribute("data-theme", stored);
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
	}
</style>
