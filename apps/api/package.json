{
  "name": "@exams-generator/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "DOTENV_CONFIG_PATH=../../.env PORT=3012 ts-node-dev --respawn --exit-child --transpile-only -r dotenv/config -r tsconfig-paths/register src/main.ts",
    "dev": "DOTENV_CONFIG_PATH=../../.env PORT=3012 ts-node-dev --respawn --exit-child --transpile-only -r dotenv/config -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest; status=$?; pnpm db:purge-test-taxonomy; exit $status",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate --schema=./src/db/schema/index.ts --dialect=postgresql --out=./drizzle",
    "db:migrate": "DOTENV_CONFIG_PATH=../../.env ts-node -r dotenv/config -r tsconfig-paths/register src/db/migrate.ts",
    "db:seed": "DOTENV_CONFIG_PATH=../../.env ts-node -r dotenv/config -r tsconfig-paths/register src/db/seed.ts",
    "db:seed:bank-sample": "DOTENV_CONFIG_PATH=../../.env ts-node -r dotenv/config -r tsconfig-paths/register src/scripts/seed-bank-sample.ts",
    "db:purge-test-taxonomy": "DOTENV_CONFIG_PATH=../../.env ts-node -r dotenv/config -r tsconfig-paths/register src/scripts/purge-test-taxonomy.ts"
  },
  "dependencies": {
    "@exams-generator/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.9",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "multer": "^2.0.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^10.4.4",
    "@types/archiver": "^6.0.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.24.2",
    "eslint": "^10.7.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0"
  }
}
