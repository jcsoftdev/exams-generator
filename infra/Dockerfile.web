FROM node:22-bookworm-slim AS base
ENV CI=true

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
# No `|| pnpm install` fallback — see Dockerfile.api (audit 2026-08-20 H5).
RUN pnpm install --frozen-lockfile --filter "@exams-generator/web..."

FROM deps AS build
COPY . .
# @exams-generator/shared must be built first -- `ng build` does not resolve
# turbo's `dependsOn: ["^build"]` on its own, and web imports shared's dist output.
RUN pnpm --filter @exams-generator/shared build
RUN pnpm --filter @exams-generator/web build

# nginx-unprivileged, not nginx: the stock image runs its master process as
# root (audit 2026-08-20, H5). This one runs as uid 101 the whole way, which
# costs exactly one thing — it cannot bind :80, so the server listens on 8080.
#
# DEPLOY STEP, and it is not optional: Dokploy routes to a container port set
# in its UI. It still says 80. Change it to 8080 for this service in the SAME
# window as this deploy, or Traefik will 502 against a container that is
# healthy and listening.
FROM nginxinc/nginx-unprivileged:alpine AS runtime
COPY --from=build /app/apps/web/dist/web/browser /usr/share/nginx/html
COPY infra/nginx/web.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
