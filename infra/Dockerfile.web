FROM node:22-bookworm-slim AS base
ENV CI=true

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --filter "@exams-generator/web..." || pnpm install --filter "@exams-generator/web..."

FROM deps AS build
COPY . .
# @exams-generator/shared must be built first -- `ng build` does not resolve
# turbo's `dependsOn: ["^build"]` on its own, and web imports shared's dist output.
RUN pnpm --filter @exams-generator/shared build
RUN pnpm --filter @exams-generator/web build

FROM nginx:alpine AS runtime
COPY --from=build /app/apps/web/dist/web/browser /usr/share/nginx/html
COPY infra/nginx/web.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
