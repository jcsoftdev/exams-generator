FROM node:22-bookworm-slim AS base
ENV CI=true

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/landing/package.json apps/landing/package.json
# No `|| pnpm install` fallback — see Dockerfile.api (audit 2026-08-20 H5).
RUN pnpm install --frozen-lockfile --filter "@exams-generator/landing..."

FROM deps AS build
COPY . .
RUN pnpm --filter @exams-generator/landing build

FROM nginx:alpine AS runtime
COPY --from=build /app/apps/landing/dist /usr/share/nginx/html
COPY infra/nginx/landing.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
