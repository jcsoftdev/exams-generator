FROM node:22-bookworm-slim AS base
ENV CI=true

# Install the typst CLI binary (PdfCompilerPort adapter dependency).
# Pinned version — bump deliberately when upgrading Typst.
ARG TYPST_VERSION=0.15.1
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates xz-utils tesseract-ocr tesseract-ocr-spa \
  && curl -fsSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" \
       -o /tmp/typst.tar.xz \
  && tar -xJf /tmp/typst.tar.xz -C /tmp \
  && mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
  && chmod +x /usr/local/bin/typst \
  && rm -rf /tmp/typst* \
  && apt-get purge -y curl xz-utils \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.9.0 --activate

WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
# No `|| pnpm install` fallback (audit 2026-08-20 H5): the fallback turned a
# lockfile out of sync with package.json into a silently non-reproducible
# "green" build. A desynced lockfile must fail the build.
RUN pnpm install --frozen-lockfile --filter "@exams-generator/api..."

FROM deps AS build
COPY . .
# Build the shared package first: @exams-generator/api resolves it via its
# package.json main/types (dist/), and this Dockerfile invokes pnpm directly
# (not turbo), so the ^build dependency is not auto-resolved. Mirrors Dockerfile.web.
RUN pnpm --filter @exams-generator/shared build
RUN pnpm --filter @exams-generator/api build
RUN pnpm --filter @exams-generator/api deploy --prod --legacy /app/deploy

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app/deploy ./

# Proves `sharp`'s native binary actually loads in THIS image at build time,
# not at deploy time (recommendation, ai-question-image-crop final review).
# `pnpm deploy --prod` prunes devDependencies but not optionalDependencies —
# sharp ships its platform binary as one — and `sharp` is imported at module
# top level in the image-cropper adapter, so a broken binary would otherwise
# fail at app boot, not here. Zero network dependency: sharp's binary was
# already installed by the `deps` stage above.
RUN node -e "require('sharp')"

# Gate on the LANGUAGE, not just the binary. `tesseract --version` exits 0
# with zero language packs installed, while `TesseractCliAdapter` invokes
# `-l spa`; a missing `spa.traineddata` exits non-zero at runtime, `buildCrops`
# swallows it by design, and every extraction silently loses its figure behind
# a `logger.warn`. The tesseract packages are installed in the same `apt-get`
# line as curl/xz-utils, which are purged and `autoremove`d further up — an
# `autoremove` that ever treats `tesseract-ocr-spa` as an orphan produces
# exactly that while a `--version` gate stays green.
# `grep -qx` (Debian ships it; ripgrep is not in this image) requires the
# whole line to be exactly `spa`, so a language merely containing those
# letters cannot satisfy it. `2>&1` because tesseract writes the list header
# to stderr.
RUN tesseract --list-langs 2>&1 | grep -qx spa

# Non-root (audit 2026-08-20 H5). The `node` user ships with the base image;
# the app only ever writes to os.tmpdir() (exam-generation temp dirs), which
# is world-writable, so read-only /app is fine.
USER node

EXPOSE 3000
CMD ["node", "dist/main.js"]
