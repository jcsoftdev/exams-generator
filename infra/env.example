# Copy this file to a root-level dotenv file before running docker compose:
#   cp infra/env.example ../.env    (from infra/)  OR  cp infra/env.example .env  (from repo root)
# The root dotenv filename is intentionally NOT committed here — sandbox
# permissions in this environment deny writes to any ".env*" path, so the
# template lives at infra/env.example instead. Copy it once locally/in CI.

# --- Database (Postgres) ---
DB_USER=exams
DB_PASSWORD=exams
DB_NAME=exams_generator
DB_PORT=5439
DATABASE_URL=postgres://exams:exams@localhost:5439/exams_generator

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9030
MINIO_CONSOLE_PORT=9003
MINIO_ENDPOINT=localhost
# Bucket the api reads/writes generated assets to (storage-provider.ts).
MINIO_BUCKET=exams-generator

# --- Auth ---
# DEV/LOCAL default only. In production the API REFUSES to boot with this value
# (or anything under 32 chars) — see apps/api/src/modules/auth/env.ts. Generate
# a real one with:  openssl rand -base64 48
JWT_SECRET=change-me-in-every-environment

# Bearer token Prometheus sends to GET /metrics. Leave empty in dev (the
# endpoint is open there); in production the API refuses to serve metrics
# until this is set, so an unset value fails closed instead of publishing
# traffic shape and queue backlogs to anyone who asks.
METRICS_TOKEN=

# --- Redis (BullMQ `generation` queue — AI jobs) ---
# REDIS_HOST_PORT is the host-side mapping for local dev (api outside Docker
# reaches redis at localhost:6390). Inside Docker the api service always gets
# REDIS_HOST=redis / REDIS_PORT=6379 from the compose files.
REDIS_HOST_PORT=6390
# REDIS_HOST/REDIS_PORT are what the api itself connects to (queue.env.ts) —
# only override when pointing at an external/managed Redis instead of the
# compose service.
REDIS_HOST=localhost
REDIS_PORT=6390
# Redis AUTH password. Leave EMPTY for local dev (the local compose runs
# Redis without auth; an empty value makes the api skip AUTH entirely —
# see resolveRedisConnection in apps/api/src/common/queue.env.ts).
# REQUIRED in production: infra/docker-compose.dokploy.yml refuses to start
# without it and runs redis-server with --requirepass (audit 2026-08-20 H4).
REDIS_PASSWORD=
# BullMQ key prefix for the whole queue namespace. Leave empty in dev/prod —
# BullMQ then uses its own default ("bull"). Only the e2e jest specs set this,
# per test file, to isolate parallel suites on the shared local Redis.
BULLMQ_PREFIX=

# --- AI (QuestionGeneratorPort / OpenRouterAdapter) ---
# OpenRouter's free-tier model list ROTATES — a stale slug returns HTTP 404
# ("no endpoints"). The adapter sends response_format: json_schema, so a model
# MUST support structured outputs. List current free + structured ones:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[]
#     | select((.id|endswith(":free")) and (((.supported_parameters//[])|index("response_format"))
#       or ((.supported_parameters//[])|index("structured_outputs"))))
#     | "\(.id) img=\((.architecture.input_modalities|index("image"))!=null)"'
#
# Two models, each on its strength:
#   AI_MODEL         → text ops (generate, revise) — strongest free academic/reasoning model.
#   AI_VISION_MODEL  → extractFromImage only (photo → question) — needs a vision model.
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_API_KEY=
#
# --- Using a provider other than OpenRouter ---
# The adapter speaks plain OpenAI chat-completions (Bearer auth, no
# OpenRouter-specific headers), so any compatible endpoint works by url alone.
#
#   AI_BASE_URL          full chat-completions url; defaults to OpenRouter's.
#   AI_API_KEY           provider-neutral key. `OPENROUTER_API_KEY` still works
#                        and is used when this is unset.
#   AI_RESPONSE_FORMAT   json_schema (default; OpenRouter/OpenAI strict
#                        structured output) or json_object (providers with
#                        plain JSON mode only). In json_object mode the schema
#                        is embedded in the prompt and enforced client-side.
#   AI_THINKING          enabled | disabled. Unset = field not sent. DeepSeek V4
#                        reasons by default and can spend the whole max_tokens
#                        budget on reasoning_content, answering with EMPTY
#                        content (finish_reason=length) — set disabled there.
#
# DeepSeek's own API (verified 2026-09-02, api-docs.deepseek.com): it does NOT
# support json_schema, only json_object; deepseek-chat/deepseek-reasoner were
# retired 2026-07-24; text models are deepseek-v4-flash / deepseek-v4-pro and
# ONLY deepseek-v4-flash-vision-exp accepts images — any other model answers
# 400 "This model does not support image" to the photo extraction:
#   AI_BASE_URL=https://api.deepseek.com/chat/completions
#   AI_API_KEY=sk-...
#   AI_MODEL=deepseek-v4-flash
#   AI_VISION_MODEL=deepseek-v4-flash-vision-exp
#   AI_RESPONSE_FORMAT=json_object
#   AI_THINKING=disabled
AI_BASE_URL=
AI_API_KEY=
AI_RESPONSE_FORMAT=
AI_THINKING=

# --- API ---
API_PORT=3012
PORT=3000
# Base URL the one-off seeding scripts in apps/api/src/scripts/ call the API
# on (they hit it over HTTP, not the DB directly).
API_BASE_URL=http://localhost:3012

# --- Web ---
WEB_PORT=8080

# --- Local port map (registered in the port-registry MCP under project "exams-generator") ---
# postgresql 5439 | minio 9030 | minio-console 9003 | redis 6390
# nestjs-api 3012 | angular-web-dev 4201 | nginx-web-docker 8080 | astro (landing dev) 4322
